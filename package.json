{
  "name": "shotinclean",
  "version": "1.0.0",
  "description": "A CleanShot-style screenshot & screen recording app for the browser",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "shots": "node scripts/marketing-shots.mjs",
    "shots:optimize": "python3 scripts/optimize-assets.py",
    "og": "node scripts/og-image.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galliharmada/shotinclean.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/galliharmada/shotinclean/issues"
  },
  "homepage": "https://github.com/galliharmada/shotinclean#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-static-copy": "^2.3.2",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@clerk/clerk-js": "^6.40.0",
    "@clerk/ui": "^1.41.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "gifenc": "^1.0.3",
    "tesseract.js": "^5.1.1"
  },
  "private": true,
  "type": "module"
}
